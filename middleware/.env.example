# Copy to middleware/.env and fill in. .env is gitignored — never commit real
# values (docs/CLAUDE.md: a committed secret is a compromised secret).

# --- Database -------------------------------------------------------------
# Postgres connection string used by db/pool.ts, db/migrate.ts and seed/seed.ts.
DATABASE_URL=postgres://bus_ridership:CHANGE_ME@localhost:5432/bus_ridership

# Max pooled connections. Optional, defaults to 10.
PGPOOL_MAX=10

# Set to "require" for managed Postgres that terminates TLS with a certificate
# the default Node trust store does not carry. Leave unset for local Postgres.
# PGSSL=require

# --- Seed -----------------------------------------------------------------
# Optional. Service date for the seeded route_runs (YYYY-MM-DD). Defaults to today.
# SEED_SERVICE_DATE=2026-09-02

# Guard rail: the seed refuses to run when NODE_ENV=production unless this is
# "yes". It truncates the roster.
# SEED_ALLOW_PRODUCTION=no

# --- Verkada webhook ------------------------------------------------------
# Shared secret from Command → Organization Settings → Verkada API → Webhooks.
# Used to verify the Verkada-Signature header (D-011). No default and no
# fallback: the service refuses to start without it, because a middleware that
# accepts unsigned events is worse than one that is down.
VERKADA_WEBHOOK_SECRET=CHANGE_ME

# --- Runtime --------------------------------------------------------------
NODE_ENV=development

# HTTP port for the middleware.
PORT=3000

# Roster export consumed at startup:
#   SEED_ROSTER_OUT=./roster.json npm run seed
# Without it every tap resolves to unknown_user.
ROSTER_FILE=./roster.json

# Optional JSON override for the device_id -> bus map. Defaults to the seed
# convention (RDR-101-DOOR -> BUS-101, ...). In production this comes from the
# readers table instead.
# DEVICE_BUS_MAP={"RDR-101-DOOR":"BUS-101"}
